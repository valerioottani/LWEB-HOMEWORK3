<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="playlist">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="lista" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="id" type="xs:positiveInteger" minOccurs="1"/>
              <xs:element name="titolo" type="xs:string" minOccurs="1"/>
              <xs:element name="descrizione" type="xs:string" minOccurs="1"/>
              <xs:element name="immagine" type="xs:string" minOccurs="1"/>
              <xs:element name="sfondo" type="xs:string" minOccurs="1"/>
              <xs:element name="tipo" type="xs:string" minOccurs="1"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
