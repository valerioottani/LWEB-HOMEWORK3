<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="eventi">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="evento" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="id" type="xs:positiveInteger" minOccurs="1"/>
              <xs:element name="giorno" type="xs:positiveInteger" minOccurs="1"/>
              <xs:element name="mese" type="xs:string" minOccurs="1"/>
              <xs:element name="titolo" type="xs:string" minOccurs="1"/>
              <xs:element name="luogo" type="xs:string" minOccurs="1"/>
              <xs:element name="link_biglietti" type="xs:anyURI" minOccurs="1"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
