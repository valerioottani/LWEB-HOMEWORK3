<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="acquisti_merch">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="acquisto" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="id" type="xs:positiveInteger" minOccurs="1"/>
              <xs:element name="username" type="xs:string" minOccurs="1"/>
              <xs:element name="merchandise_id" type="xs:positiveInteger" minOccurs="1"/>
              <xs:element name="quantita" type="xs:positiveInteger" minOccurs="1"/>
              <xs:element name="data_acquisto" type="xs:string" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
