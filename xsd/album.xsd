<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="album">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="disco" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="id" type="xs:positiveInteger" minOccurs="1"/>
              <xs:element name="artista_id" type="xs:positiveInteger" minOccurs="1"/>
              <xs:element name="titolo" type="xs:string" minOccurs="1"/>
              <xs:element name="anno" type="xs:gYear" minOccurs="1"/>
              <xs:element name="copertina" type="xs:string" minOccurs="1"/>
              <xs:element name="curiosita" type="xs:string" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
